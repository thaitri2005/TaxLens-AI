APP_ENV=development
APP_NAME=TaxLens AI
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=taxlens
DATABASE_USER=taxlens
DATABASE_PASSWORD=taxlens
LOCAL_STORAGE_PATH=./data/local

OBJECT_STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=raw-documents
AZURE_STORAGE_NORMALIZED_CONTAINER=normalized-text
DATABASE_SSL_MODE=

EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_MODEL_PATH=./data/models/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=32
OCR_ENABLED=true
OCR_LANGUAGE=vie+eng
OCR_RENDER_SCALE=2.0
OCR_TIMEOUT_SECONDS=30

HF_TOKEN=
HF_CHAT_BASE_URL=https://router.huggingface.co/v1
HF_CHAT_MODEL=Qwen/Qwen3-4B-Instruct-2507
HF_CHAT_ROUTING_POLICY=cheapest
HF_CHAT_TIMEOUT_SECONDS=30
HF_CHAT_MAX_OUTPUT_TOKENS=1400
HF_CHAT_TEMPERATURE=0.1

MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=taxlens-qa
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-locally
AIRFLOW_FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AIRFLOW_SECRET_KEY=change-me-locally
AIRFLOW_INTERNAL_TOKEN=change-me-locally
TAXLENS_DAILY_SOURCE_LIMIT=100
TAXLENS_DISCOVERY_PAGES=10
TAXLENS_PROCESS_BATCH_SIZE=1
TAXLENS_PROCESS_MAX_BATCHES=20
AUTH_INTERNAL_TOKEN=change-me-locally
NEXTAUTH_SECRET=change-me-locally
NEXTAUTH_URL=http://localhost:3000
AUTH_INITIAL_ADMIN_USERNAME=admin
AUTH_INITIAL_ADMIN_PASSWORD=
AUTH_RATE_LIMIT_PER_MINUTE=10
