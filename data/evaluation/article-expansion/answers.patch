--- /dev/null
+++ b/src/taxlens/retrieval/expansion.py
@@ -0,0 +1,84 @@
+"""Article expansion: fill an evidence passage's window with the rest of its article.
+
+Search finds clauses, and the clause a question needs is often the next one of the same article
+(the rate after the cases, the exception after the rule), or a clause with little text of its
+own ("10% applies to goods not in clauses 1 and 2"). Answers send each passage cut to a window;
+most clauses fill a fraction of it, so the rest of the window takes the article's other passages,
+nearest first, each whole or not at all. Measured in data/evaluation/article-expansion.
+"""
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from uuid import UUID
+
+from sqlalchemy import func, select
+from sqlalchemy.orm import Session
+
+from taxlens.legal_data.models import DocumentChunk
+from taxlens.retrieval.search import SearchResult
+
+# The characters of each passage answers send to the model and check facts against.
+PASSAGE_WINDOW = 2500
+
+
+@dataclass(frozen=True)
+class Window:
+    text: str
+    expanded: bool
+    """Whether text from other passages of the article was added."""
+
+
+def fill_window(sizes: Sequence[int], position: int, window: int) -> list[int]:
+    """Indexes, in reading order, of the passages that fit with the one at ``position``.
+
+    Neighbours are tried nearest first (next, then previous, then outward), each whole.
+    """
+
+    chosen = [position]
+    used = sizes[position]
+    for step in range(1, len(sizes)):
+        for index in (position + step, position - step):
+            if 0 <= index < len(sizes) and used + sizes[index] <= window:
+                used += sizes[index]
+                chosen.append(index)
+    return sorted(chosen)
+
+
+def article_windows(
+    session: Session, results: Sequence[SearchResult], window: int = PASSAGE_WINDOW
+) -> dict[UUID, Window]:
+    """Each result's window text, by passage id."""
+
+    windows = {}
+    for result in results:
+        chunk = result.chunk
+        passages = _article_passages(session, chunk) if chunk.article_number else []
+        ids = [passage.id for passage in passages]
+        if chunk.id not in ids:
+            windows[chunk.id] = Window(chunk.content[:window], False)
+            continue
+        chosen = fill_window([len(p.content) for p in passages], ids.index(chunk.id), window)
+        text = "\n".join(passages[index].content for index in chosen)
+        windows[chunk.id] = Window(text[:window], len(chosen) > 1)
+    return windows
+
+
+def _article_passages(session: Session, chunk: DocumentChunk) -> list[DocumentChunk]:
+    """The article's passages in reading order, as the document view orders them."""
+
+    return list(
+        session.scalars(
+            select(DocumentChunk)
+            .where(
+                DocumentChunk.document_version_id == chunk.document_version_id,
+                DocumentChunk.article_number == chunk.article_number,
+            )
+            .order_by(
+                DocumentChunk.page_start.asc().nulls_last(),
+                DocumentChunk.clause_number.is_not(None),
+                func.length(DocumentChunk.clause_number),
+                DocumentChunk.clause_number,
+                DocumentChunk.id,
+            )
+        )
+    )
